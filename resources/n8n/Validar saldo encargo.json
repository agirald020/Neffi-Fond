    {
      "parameters": {
        "jsCode": "const montoOrdenGiro = $json.montoOrdenGiro;\nconst montoDisponible = $json.montoDisponible;\n\nvar descripcion = \"\", aprobado = false;\n\nif (montoDisponible != null) {\n  if (montoDisponible > montoOrdenGiro) {\n    aprobado = true;\n    descripcion = \"Saldo disponible para pago de orden de giro.\";\n  } else {\n    descripcion = \"El monto disponible es menor que el monto de la orden de giro.\";\n  }\n} else {\n  descripcion = \"No fué posible obtener el saldo disponible del encargo.\";\n}\n\nreturn [\n  {\n    json: {\n      aprobado,\n      descripcion\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
