        "jsCode": "const numero = $('Start').first().json.numero_encargo;\n\nconst numeroFondo = numero\n    ? parseInt(String(numero).padStart(12, '0').substring(0, 3), 10)\n    : null;\n\nreturn [\n  {\n    json: {\n      numeroFondo\n    }\n  }\n];"
