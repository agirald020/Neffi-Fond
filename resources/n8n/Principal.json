    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const base64 = item.json.documento_base64;\n  const nit = $('Webhook').first().json.body.nit;\n\n  const mimeType = item.json.mime_type || 'image/jpeg';\n  let extension = mimeType.split('/')[1];\n  if (extension === 'jpeg') extension = 'jpg';\n\n  results.push({\n    json: {\n      nit: nit\n    },\n    binary: {\n      documento: {\n        data: base64,\n        mimeType: mimeType,\n        fileName: `documento.${extension}`\n      }\n    }\n  });\n}\n\nreturn results;"
      },
