      "parameters": {
        "jsCode": "const nombres = ['Validar Anexos', 'Validar Vinculacion', 'Validar saldo encargo'];\n\nconst resultados = items.map((item, index) => {\n  return {\n    subworkflow: nombres[index],\n    aprobado: item.json.aprobado,\n    descripcion: item.json.descripcion\n  };\n});\n\nconst aprobado = items[0].json.aprobado && items[2].json.aprobado;\nconst accion = aprobado ? !items[1].json.aprobado ? 'LISTAS' : 'APROBAR' : null;\n\nreturn [\n  {\n    json: {\n      estado: $('Switch').first().json.estado_actual,\n      aprobado: aprobado,\n      descripcion: resultados,\n      accion: accion\n    }\n  }\n];"
