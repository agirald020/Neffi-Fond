        "jsCode": "// Consultar Vinculacion - puede venir vacío o con datos\nconst raw = $input.first()?.json ?? [];\nconst lista = Array.isArray(raw) ? raw : [raw];\n\nconst rechazados = lista.filter(persona => persona.permiteIdentificacion === \"NO\");\n\n// Split Out3 - nit\nconst nitTerceroPago = $('Split Out').first().json.nitTerceroPago;\n\nreturn {\n  json: {\n    nitTerceroPago,\n    permiteVinculacion: rechazados.length === 0 ? \"SI\" : \"NO\"\n  }\n};"
