      "parameters": {
        "jsCode": "const terceros = $json.terceros || [];\nconst aprobado = terceros.every(ter => ter.permiteVinculacion === \"SI\");\nconst rechazados = terceros.filter(ter => ter.permiteVinculacion === \"NO\");\n\nvar descripcion = \"\";\n\nif (aprobado) {\n  descripcion = \"Todos los terceros permiten vinculación.\";\n} else {\n  for (var rec of rechazados) {\n    descripcion += `Documento: ${rec.nitTerceroPago}. No permite vinculación \\n`;\n  }\n}\n\nreturn [\n  {\n    json: {\n      aprobado,\n      descripcion\n    }\n  }\n];"
      },
