# Keycloak Configuration
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=neffi-trust
KEYCLOAK_CLIENT_ID=neffi-trust-client
KEYCLOAK_CLIENT_SECRET=your-client-secret

# Session Configuration
SESSION_SECRET=your-session-secret-key

# Redis Configuration (optional - for production)
# REDIS_URL=redis://localhost:6379

# Database Configuration
# DATABASE_URL=postgresql://user:password@localhost:5432/neffi_trust

# Object Storage Configuration (already configured by Replit)
# DEFAULT_OBJECT_STORAGE_BUCKET_ID=
# PUBLIC_OBJECT_SEARCH_PATHS=
# PRIVATE_OBJECT_DIR=

# AdmonFondos-Api (solo backend — ver politica de integracion en CLAUDE.md)
ADMONFONDOS_API_BASE_URL=http://192.168.2.10:8098/admonfondos/api/v1
ADMONFONDOS_API_TIMEOUT_MS=30000
# Solo para desarrollo con AUTH_BYPASS=true, cuando no hay JWT real de Keycloak:
ADMONFONDOS_API_DEV_TOKEN=